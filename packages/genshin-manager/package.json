{
  "name": "genshin-manager",
  "version": "0.0.1",
  "description": "Genshin Impact data manager with asset caching, Enka integration, and notice tracking",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Rollphes",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@genshin-manager/core": "workspace:*",
    "@genshin-manager/data": "workspace:*",
    "@genshin-manager/enka": "workspace:*",
    "@genshin-manager/models": "workspace:*",
    "@genshin-manager/notice": "workspace:*",
    "@genshin-manager/sync": "workspace:*",
    "node-cron": "^3.0.3",
    "ts-deepmerge": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^24.2.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^54.0.0",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
