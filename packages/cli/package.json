{
  "name": "@genshin-manager/cli",
  "private": true,
  "version": "0.0.1",
  "description": "CLI utilities for genshin-manager development scripts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "browser": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Rollphes",
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^1.1.0",
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^54.0.0",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.39.0"
  }
}
