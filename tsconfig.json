{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@genshin-manager/core": ["./packages/core/dist"],
      "@genshin-manager/crypto": ["./packages/crypto/dist"],
      "@genshin-manager/data": ["./packages/data/dist"],
      "@genshin-manager/sync": ["./packages/sync/dist"],
      "@genshin-manager/models": ["./packages/models/dist"],
      "@genshin-manager/enka": ["./packages/enka/dist"],
      "@genshin-manager/notice": ["./packages/notice/dist"],
      "genshin-manager": ["./packages/genshin-manager/dist"]
    }
  },
  "include": ["scripts"],
  "exclude": ["node_modules", "dist", "packages", "docs-site"]
}
