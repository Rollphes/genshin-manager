{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@genshin-manager/core": [
        "./packages/core/dist"
      ],
    }
  },
  "include": [
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages"
  ]
}