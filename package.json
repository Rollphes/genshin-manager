{
  "name": "genshin-manager",
  "version": "2.0.8",
  "packageManager": "pnpm@9.15.2",
  "homepage": "https://rollphes.github.io/genshin-manager/",
  "bugs": "https://github.com/Rollphes/genshin-manager/issues",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "my-test": "tsx scripts/debug.ts",
    "generate:types": "tsx scripts/generate-types-from-master.ts",
    "generate:master": "tsx scripts/generate-structural-master.ts",
    "docs:dev": "cd docs-site && npm run dev",
    "docs:build": "cd docs-site && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nodejs",
    "wrapper",
    "node",
    "node-js",
    "nodejs-modules",
    "wrapper-api",
    "wrapper-library",
    "genshin",
    "genshin-impact",
    "genshin-api",
    "genshin-artifacts",
    "enkanetwork",
    "enka-network",
    "enka"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rollphes/genshin-manager.git"
  },
  "author": "Rollphes",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@commitlint/config-conventional": "^20.4.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "lru-cache": "^11.2.5",
    "node-cron": "^4.2.1",
    "proper-lockfile": "^4.1.2",
    "quicktype-core": "^23.2.6",
    "ts-deepmerge": "^7.0.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@eslint/js": "^9.39.2",
    "@types/cheerio": "^1.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/html-escaper": "^3.0.4",
    "@types/node": "^25.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-jsdoc": "^62.5.0",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.4"
  }
}
